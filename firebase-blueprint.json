{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "E-commerce physical product for sale in Bangladesh",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "nameBn": { "type": "string", "maxLength": 200 },
        "name": { "type": "string", "maxLength": 200 },
        "category": { "type": "string", "maxLength": 100 },
        "categoryBn": { "type": "string", "maxLength": 100 },
        "price": { "type": "number" },
        "originalPrice": { "type": "number" },
        "discountPercent": { "type": "number" },
        "stock": { "type": "number" },
        "image": { "type": "string", "maxLength": 1000 },
        "description": { "type": "string", "maxLength": 2000 },
        "badge": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "nameBn", "category", "price", "image", "stock"]
    },
    "Category": {
      "title": "Category",
      "description": "Product category definition",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "slug": { "type": "string", "maxLength": 100 },
        "nameBn": { "type": "string", "maxLength": 100 },
        "nameEn": { "type": "string", "maxLength": 100 },
        "iconName": { "type": "string", "maxLength": 50 },
        "itemCount": { "type": "number" }
      },
      "required": ["id", "slug", "nameBn"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer order with Cash on Delivery and customer details",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "orderNumber": { "type": "string", "maxLength": 50 },
        "createdAt": { "type": "string", "maxLength": 100 },
        "customerName": { "type": "string", "maxLength": 100 },
        "phone": { "type": "string", "maxLength": 20 },
        "division": { "type": "string", "maxLength": 100 },
        "district": { "type": "string", "maxLength": 100 },
        "address": { "type": "string", "maxLength": 500 },
        "deliveryFee": { "type": "number" },
        "paymentMethod": { "type": "string", "enum": ["cod", "bkash", "nagad"] },
        "subtotal": { "type": "number" },
        "total": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "processing", "shipped", "delivered", "cancelled"] }
      },
      "required": ["id", "orderNumber", "customerName", "phone", "address", "total", "status"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": { "$ref": "#/entities/Product" },
      "description": "Catalog of physical products available in store"
    },
    "/categories/{categoryId}": {
      "schema": { "$ref": "#/entities/Category" },
      "description": "Product categories"
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/Order" },
      "description": "Customer purchase orders with Cash on Delivery information"
    }
  }
}
